      "gold": {"jobs": [{"mode": "pack", "inputs": {"R": {"texture": "/Game/Env/Bark/T_Bark_ORM", "channel": "G"}, "G": "/Game/Env/Bark/T_Bark_Height"}, "outputPath": "/Game/Env/Bark", "outputName": "T_Bark_RH"}]},
      "equivalents": [
        {"jobs": [{"mode": "pack", "preset": "Custom", "inputs": {"R": {"texture": "/Game/Env/Bark/T_Bark_ORM", "channel": "Green"}, "G": {"texture": "/Game/Env/Bark/T_Bark_Height"}}, "outputPath": "/Game/Env/Bark", "outputName": "T_Bark_RH"}]}
      ],
      "negatives": [
