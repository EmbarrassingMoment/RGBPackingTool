{
  "version": 1,
  "notes": "Hand-written cases for run_eval.py. Each case gives the model a request in natural language; the model writes a job file, and the grader compares what that job file would do (jobsim.simulate) with what the gold job file does in the same world. Gold answers are human-written and checked against the C++ source. Asset names avoid the ones used in Docs/Headless*.md so an answer cannot be copied from an example. 'equivalents' are differently written answers that do the same thing, which selftest asserts the grader accepts; 'negatives' are plausible wrong answers that selftest asserts the grader rejects; 'expect' is a substring of a diff field the grader must report for it.",
  "cases": [
    {
      "id": "pack-orm-basic",
      "tags": ["pack", "output-folder"],
      "prompt": {
        "en": "Pack the cliff textures /Game/Env/Cliff/T_Cliff_AO, /Game/Env/Cliff/T_Cliff_Roughness and /Game/Env/Cliff/T_Cliff_Metallic into a standard ORM texture. Put it in the same folder as the inputs.",
        "ja": "崖のテクスチャ /Game/Env/Cliff/T_Cliff_AO、/Game/Env/Cliff/T_Cliff_Roughness、/Game/Env/Cliff/T_Cliff_Metallic を標準的な ORM テクスチャにパックしてください。出力は入力と同じフォルダに置いてください。"
      },
      "world": {
        "/Game/Env/Cliff/T_Cliff_AO": {"size": [2048, 2048]},
        "/Game/Env/Cliff/T_Cliff_Roughness": {"size": [2048, 2048]},
        "/Game/Env/Cliff/T_Cliff_Metallic": {"size": [2048, 2048]}
      },
      "gold": {"jobs": [{"mode": "pack", "preset": "ORM", "inputs": {"R": "/Game/Env/Cliff/T_Cliff_AO", "G": "/Game/Env/Cliff/T_Cliff_Roughness", "B": "/Game/Env/Cliff/T_Cliff_Metallic"}, "outputPath": "/Game/Env/Cliff"}]},
      "equivalents": [
        {"jobs": [{"mode": "Pack", "inputs": {"R": "Texture2D'/Game/Env/Cliff/T_Cliff_AO.T_Cliff_AO'", "G": "/Game/Env/Cliff/T_Cliff_Roughness.T_Cliff_Roughness", "B": {"texture": "/Game/Env/Cliff/T_Cliff_Metallic", "channel": "red", "invert": false}, "A": null}, "width": 2048, "height": 2048, "outputPath": "/Game/Env/Cliff/", "outputName": "T_Cliff_ORM", "compression": "masks", "overwrite": "fail", "save": true, "dryRun": false}]}
      ],
      "negatives": [
        {"why": "outputPath left at its /Game default", "expect": "pack.output",
         "answer": {"jobs": [{"mode": "pack", "preset": "ORM", "inputs": {"R": "/Game/Env/Cliff/T_Cliff_AO", "G": "/Game/Env/Cliff/T_Cliff_Roughness", "B": "/Game/Env/Cliff/T_Cliff_Metallic"}}]}},
        {"why": "AO and Metallic swapped", "expect": "pack.inputs.R.texture",
         "answer": {"jobs": [{"mode": "pack", "preset": "ORM", "inputs": {"R": "/Game/Env/Cliff/T_Cliff_Metallic", "G": "/Game/Env/Cliff/T_Cliff_Roughness", "B": "/Game/Env/Cliff/T_Cliff_AO"}, "outputPath": "/Game/Env/Cliff"}]}},
        {"why": "slot keys spelled out (only R/G/B/A are accepted)", "expect": "error",
         "answer": {"jobs": [{"mode": "pack", "preset": "ORM", "inputs": {"Red": "/Game/Env/Cliff/T_Cliff_AO", "Green": "/Game/Env/Cliff/T_Cliff_Roughness", "Blue": "/Game/Env/Cliff/T_Cliff_Metallic"}, "outputPath": "/Game/Env/Cliff"}]}},
        {"why": "a file-system path instead of a content path", "expect": "error",
         "answer": {"jobs": [{"mode": "pack", "preset": "ORM", "inputs": {"R": "/Game/Env/Cliff/T_Cliff_AO", "G": "/Game/Env/Cliff/T_Cliff_Roughness", "B": "/Game/Env/Cliff/T_Cliff_Metallic"}, "outputPath": "/Content/Env/Cliff"}]}}
      ]
    },
    {
      "id": "pack-mra-order",
      "tags": ["pack", "preset-layout"],
      "prompt": {
        "en": "Our engine expects MRA-packed masks. Pack /Game/Items/Barrel/T_Barrel_Metallic, /Game/Items/Barrel/T_Barrel_Roughness and /Game/Items/Barrel/T_Barrel_AO into an MRA texture in /Game/Items/Barrel.",
        "ja": "このプロジェクトのシェーダーは MRA 形式のマスクを前提にしています。/Game/Items/Barrel/T_Barrel_Metallic、/Game/Items/Barrel/T_Barrel_Roughness、/Game/Items/Barrel/T_Barrel_AO を MRA テクスチャにパックし、/Game/Items/Barrel に出力してください。"
      },
      "world": {
        "/Game/Items/Barrel/T_Barrel_Metallic": {"size": [1024, 1024]},
        "/Game/Items/Barrel/T_Barrel_Roughness": {"size": [1024, 1024]},
        "/Game/Items/Barrel/T_Barrel_AO": {"size": [1024, 1024]}
      },
      "gold": {"jobs": [{"mode": "pack", "preset": "MRA", "inputs": {"R": "/Game/Items/Barrel/T_Barrel_Metallic", "G": "/Game/Items/Barrel/T_Barrel_Roughness", "B": "/Game/Items/Barrel/T_Barrel_AO"}, "outputPath": "/Game/Items/Barrel"}]},
      "equivalents": [
        {"jobs": [{"mode": "pack", "inputs": {"R": "/Game/Items/Barrel/T_Barrel_Metallic", "G": "/Game/Items/Barrel/T_Barrel_Roughness", "B": "/Game/Items/Barrel/T_Barrel_AO"}, "suffix": "_MRA", "outputPath": "/Game/Items/Barrel"}]}
      ],
      "negatives": [
        {"why": "ORM slot order under the MRA preset", "expect": "pack.inputs.R.texture",
         "answer": {"jobs": [{"mode": "pack", "preset": "MRA", "inputs": {"R": "/Game/Items/Barrel/T_Barrel_AO", "G": "/Game/Items/Barrel/T_Barrel_Roughness", "B": "/Game/Items/Barrel/T_Barrel_Metallic"}, "outputPath": "/Game/Items/Barrel"}]}},
        {"why": "MRA order but no preset, so the name gets the default _ORM suffix", "expect": "pack.output",
         "answer": {"jobs": [{"mode": "pack", "inputs": {"R": "/Game/Items/Barrel/T_Barrel_Metallic", "G": "/Game/Items/Barrel/T_Barrel_Roughness", "B": "/Game/Items/Barrel/T_Barrel_AO"}, "outputPath": "/Game/Items/Barrel"}]}}
      ]
    },
    {
      "id": "pack-invert-alpha",
      "tags": ["pack", "invert"],
      "prompt": {
        "en": "Make a mask texture for the ship hull: ambient occlusion in red, metallic in green, blue left empty, and smoothness in alpha. We only have a roughness map, so use it inverted for smoothness. The textures are /Game/Vehicles/Hull/T_Hull_AO, /Game/Vehicles/Hull/T_Hull_Metallic and /Game/Vehicles/Hull/T_Hull_Roughness. Name the result T_Hull_MS and put it in the same folder.",
        "ja": "船体用のマスクテクスチャを作ってください。赤にアンビエントオクルージョン、緑にメタリック、青は空のまま、アルファにスムースネスを入れます。スムースネスのマップはなくラフネスしかないので、ラフネスを反転して使ってください。テクスチャは /Game/Vehicles/Hull/T_Hull_AO、/Game/Vehicles/Hull/T_Hull_Metallic、/Game/Vehicles/Hull/T_Hull_Roughness です。出力名は T_Hull_MS とし、同じフォルダに置いてください。"
      },
      "world": {
        "/Game/Vehicles/Hull/T_Hull_AO": {"size": [2048, 2048]},
        "/Game/Vehicles/Hull/T_Hull_Metallic": {"size": [2048, 2048]},
        "/Game/Vehicles/Hull/T_Hull_Roughness": {"size": [2048, 2048]}
      },
      "gold": {"jobs": [{"mode": "pack", "inputs": {"R": "/Game/Vehicles/Hull/T_Hull_AO", "G": "/Game/Vehicles/Hull/T_Hull_Metallic", "A": {"texture": "/Game/Vehicles/Hull/T_Hull_Roughness", "invert": true}}, "outputPath": "/Game/Vehicles/Hull", "outputName": "T_Hull_MS"}]},
      "negatives": [
        {"why": "roughness not inverted", "expect": "pack.inputs.A.invert",
         "answer": {"jobs": [{"mode": "pack", "inputs": {"R": "/Game/Vehicles/Hull/T_Hull_AO", "G": "/Game/Vehicles/Hull/T_Hull_Metallic", "A": "/Game/Vehicles/Hull/T_Hull_Roughness"}, "outputPath": "/Game/Vehicles/Hull", "outputName": "T_Hull_MS"}]}},
        {"why": "invert placed on the job instead of the input", "expect": "error",
         "answer": {"jobs": [{"mode": "pack", "inputs": {"R": "/Game/Vehicles/Hull/T_Hull_AO", "G": "/Game/Vehicles/Hull/T_Hull_Metallic", "A": "/Game/Vehicles/Hull/T_Hull_Roughness"}, "invert": {"A": true}, "outputPath": "/Game/Vehicles/Hull", "outputName": "T_Hull_MS"}]}}
      ]
    },
    {
