         "answer": {"jobs": [{"mode": "pack", "inputs": {"R": {"texture": "/Game/Env/Bark/T_Bark_ORM", "source_channel": "G"}, "G": "/Game/Env/Bark/T_Bark_Height"}, "outputPath": "/Game/Env/Bark", "outputName": "T_Bark_RH"}]}},
        {"why": "reads the red channel (AO) instead of green", "expect": "pack.inputs.R.channel",
         "answer": {"jobs": [{"mode": "pack", "inputs": {"R": "/Game/Env/Bark/T_Bark_ORM", "G": "/Game/Env/Bark/T_Bark_Height"}, "outputPath": "/Game/Env/Bark", "outputName": "T_Bark_RH"}]}}
